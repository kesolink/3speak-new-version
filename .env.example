# ===========================================
# 3Speak New Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!

# ===========================================
# REQUIRED - Core API Configuration
# ===========================================

# Main 3Speak API endpoint (Western server)
VITE_API_URL_FROM_WEST=

# GraphQL API endpoint for video queries
VITE_GRAPHQL_API_URL=

# Video CDN domain for streaming
VITE_APP_VIDEO_CDN_DOMAIN=

# ===========================================
# REQUIRED - Upload Configuration
# ===========================================

# Authentication token for video uploads
VITE_UPLOAD_TOKEN=

# Upload endpoint URL
VITE_UPLOAD_URL=

# ===========================================
# OPTIONAL - JW Player Configuration
# ===========================================

# JW Player license credentials (optional - fallback player available)
VITE_JWPLAYER_LICENSE_ID=
VITE_JWPLAYER_LICENSE_KEY=

# ===========================================
# Video Player Configuration
# ===========================================

# Video player base URL (for iframe embed)
# Use http://localhost:3005 for local development
# Use https://play.3speak.tv for production
VITE_PLAYER_URL=

# ===========================================
# Playlists API Configuration
# ===========================================

# Playlists API endpoint
# Default: https://3speak-playlists.okinoko.io/api
VITE_PLAYLISTS_API_URL=

# ===========================================
# Feed & Views API Configuration
# ===========================================

# 3Speak feed API endpoint
VITE_FEED_URL=

# Views tracking API endpoint
VITE_VIEWS_URL=

# 3Speak tag feed URL
VITE_THREESPEAK_TAG_FEED_URL=

# ===========================================
# Hive RPC API Configuration
# ===========================================

# Hive RPC API endpoint (primary node)
# Default: https://api.hive.blog
VITE_HIVE_API_URL=

# ===========================================
# 3Speak Embed Upload (for video reactions)
# ===========================================

# Embed upload endpoint (TUS)
VITE_EMBED_UPLOAD_URL=

# Embed API base URL (for thumbnail etc.)
VITE_EMBED_API_URL=

# Embed API key (get from 3Speak team)
VITE_EMBED_API_KEY=

# ===========================================
# Shorts & Trending API Configuration
# ===========================================

# Trending sorted API endpoint
# Default: https://tags.3speak.tv/feeds/trendingSorted
VITE_TRENDING_SORTED_URL=

# Follow feed API endpoint (appends /:username)
# Default: https://tags.3speak.tv/feed
VITE_FOLLOW_FEED_URL=

# Shorts sorted API endpoint
# Default: https://tags.3speak.tv/shortssorted
VITE_SHORTS_API_URL=

# User shorts API endpoint (for per-user shorts feed)
# Default: https://tags.3speak.tv/shorts
VITE_USER_SHORTS_API_URL=

# ===========================================
# 3Speak Video Editor
# ===========================================

# Video editor iframe URL
# Use http://localhost:9091 for local development
# Use https://editor.3speak.tv for production
VITE_EDITOR_URL=

# ===========================================
# Feature Flags
# ===========================================

# Show editor features: Remix and Clip buttons (true/false)
VITE_FEATURE_EDITOR=false

# ===========================================
# HiveSigner Configuration
# ===========================================

# HiveSigner app account name
VITE_HIVESIGNER_APP=threespeak
