# <<<<<<< feat/new-renderer
# ===========================================
# 3Speak New Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!

# -------------------------------------------
# API Configuration
# -------------------------------------------

# Main 3Speak API endpoint
# =======
# 3Speak Frontend Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED - Core API Configuration
# ===========================================

# Main 3Speak API endpoint (Western server)
# >>>>>>> main
VITE_API_URL_FROM_WEST=

# GraphQL API endpoint for video queries
VITE_GRAPHQL_API_URL=

# <<<<<<< feat/new-renderer
# Video CDN domain for serving video content
VITE_APP_VIDEO_CDN_DOMAIN=

# -------------------------------------------
# Upload Configuration
# -------------------------------------------

# Token for authenticating uploads to 3Speak
# =======
# Video CDN domain for streaming
VITE_APP_VIDEO_CDN_DOMAIN=

# Pancreas API URL (for sitemaps and SEO)
VITE_PANCREAS_API_URL=https://tags.3speak.tv

# Legacy API URL
VITE_LEGACY_API_URL=https://legacy.3speak.tv

# ===========================================
# REQUIRED - SEO Configuration
# ===========================================

# Site base URL (used in meta tags, sitemaps, structured data)
VITE_SITE_URL=https://3speak.tv

# ===========================================
# REQUIRED - Upload Configuration
# ===========================================

# Authentication token for video uploads
# >>>>>>> main
VITE_UPLOAD_TOKEN=

# Upload endpoint URL
VITE_UPLOAD_URL=

# <<<<<<< feat/new-renderer
# -------------------------------------------
# JW Player (Optional - currently commented out)
# -------------------------------------------

# JW Player license credentials
# VITE_JWPLAYER_LICENSE_ID=
# VITE_JWPLAYER_LICENSE_KEY=

# -------------------------------------------
# Hive Image Upload (for uploadImageToHiv.js)
# -------------------------------------------

# Hive account credentials for image uploads
# WARNING: Be careful with posting keys!
# VITE_HIVE_POSTING_KEY=
# VITE_HIVE_USER=
# =======
# ===========================================
# OPTIONAL - JW Player Configuration
# ===========================================

# JW Player license credentials (optional - fallback player available)
VITE_JWPLAYER_LICENSE_ID=
VITE_JWPLAYER_LICENSE_KEY=

# ===========================================
# OPTIONAL - Development Overrides
# ===========================================

# Override Hive account for testing (not recommended for production)
# VITE_HIVE_USERNAME=
# VITE_HIVE_POSTING_KEY=
# >>>>>>> main

# ===========================================
# Feed & Views API Configuration
# ===========================================

# 3Speak feed API endpoint
VITE_FEED_URL=

# Views tracking API endpoint
VITE_VIEWS_URL=

# 3Speak tag feed URL
VITE_THREESPEAK_TAG_FEED_URL=

# Player URL
VITE_PLAYER_URL=

# ===========================================
# Playlists API Configuration
# ===========================================

# Playlists API endpoint
# Default: https://3speak-playlists.okinoko.io/api
VITE_PLAYLISTS_API_URL=

# ===========================================
# Hive RPC API Configuration
# ===========================================

# Hive RPC API endpoint (primary node)
# Default: https://techcoderx.com
VITE_HIVE_API_URL=

# ===========================================
# Shorts API Configuration
# ===========================================

# Shorts sorted API endpoint
# Default: https://tags.3speak.tv/shortssorted
VITE_SHORTS_API_URL=

# User shorts API endpoint (for per-user shorts feed)
# Default: https://tags.3speak.tv/shorts
VITE_USER_SHORTS_API_URL=

# ===========================================
# HiveSigner Configuration
# ===========================================

# HiveSigner app account name
VITE_HIVESIGNER_APP=threespeak
